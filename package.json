{
  "name": "ponlai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190",
    "build": "node tools/kit/qos.mjs tsc && node tools/kit/qos.mjs vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5191",
    "typecheck": "node tools/kit/qos.mjs tsc",
    "check": "node tools/check.mjs",
    "lint": "node tools/kit/qos.mjs eslint packages app",
    "lint:docs": "markdownlint-cli2 && node tools/repo/verify-doc-paths.mjs && node tools/repo/verify-doc-shape.mjs && lychee --offline --no-progress AGENTS.md ARCHITECTURE.md CREDITS.md README.md \"docs/**/*.md\" \"tools/**/*.md\" \"skills/**/*.md\" \"packages/*/AGENTS.md\" \".github/**/*.md\"",
    "lint:links": "lychee --no-progress AGENTS.md ARCHITECTURE.md CREDITS.md README.md \"docs/**/*.md\" \"tools/**/*.md\" \"skills/**/*.md\" \"packages/*/AGENTS.md\" \".github/**/*.md\""
  },
  "dependencies": {
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "i18next": "^26.4.2",
    "lil-gui": "^0.21.0",
    "lxgw-wenkai-gb-web": "^1.530.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "eslint": "^10.13.0",
    "markdownlint-cli2": "^0.24.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.2"
  }
}
